{
  "name": "blade-components",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens:build": "npx tsx src/tokens/figmaSyncTokens.ts",
    "generate-tokens": "npx tsx src/tokens/figmaSyncTokens.ts",
    "sync-tokens": "npx tsx src/tokens/figmaSyncTokens.ts",
    "tokens:watch": "echo \"Token watch is disabled. Use npm run sync-tokens manually.\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "mcp:watch": "node .mcp/watch.js",
    "dev:mcp": "concurrently \"npm run dev\" \"npm run mcp:watch\"",
    "mcp:start": "echo \"Start your MCP server here (see .mcp/config.json)\"",
    "build:tokens": "style-dictionary build"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.5",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "yn": "^5.1.0"
  }
}
